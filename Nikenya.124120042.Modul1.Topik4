1.
# Program membuat daftar_belanja

# Membuat list daftar_belanja
daftar_belanja = []

# Meminta pengguna memasukkan 3 barang
barang1 =  "sunscreen"
daftar_belanja.append(barang1)

barang2 = "lipstik"
daftar_belanja.append(barang2)

barang3 = "moisturizer"
daftar_belanja.append(barang3)

# Menampilkan daftar belanja final
print("Daftar belanja kamu adalah:", daftar_belanja)

# Menambah belanja baru ke dalam list
daftar_belanja.append("parfum")
print(f"update belanja tersedia : {daftar_belanja}")

# Menghapus belanja
daftar_belanja.remove("sunscreen")
print(f"Update setelah sunscreen habis:{daftar_belanja} ")

