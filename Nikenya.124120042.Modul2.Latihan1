# Membuat list berisi 10 bilangan
bilangan = [100, 106, 147, 20, 96, 25, 11, 31, 76, 115]

# Menampilkan list awal
print("List awal:", bilangan)

# Menambahkan satu bilangan baru
bilangan_baru = int(input("Masukkan bilangan baru:"))
bilangan.append(bilangan_baru)
print("List setelah ditambah:", bilangan)

# Menghapus bilangan tertentu
hapus = int(input("Masukkan bilangan yang ingin dihapus: "))
if hapus in bilangan:
    bilangan.remove(hapus)
    print("List setelah dihapus:", bilangan)
else:
    print("Bilangan tidak ditemukan di dalam list.")

# Menampilkan bilangan terbesar dan terkecil
print("Bilangan terbesar:", max(bilangan))
print("Bilangan terkecil:", min(bilangan))

# Membuat list berisi nama-nama mahasiswa
mahasiswa = ["Zilda", "Kenny", "Caesa", "Queen", "Azura", "Pasha", "Verol", "Mulya"]

# Menampilkan list sebelum diurutkan 
print("List sebelum diurutkan:", mahasiswa)

# Mengurutkan list secara alfabetis
mahasiswa.sort()

# Menampilkan list setelah diurutkan 
print("List setelah diurutkan (alfabetis):", mahasiswa)
