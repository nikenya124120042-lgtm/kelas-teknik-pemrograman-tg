import matplotlib.pyplot as plt

# Data sinyal
waktu = [0, 1, 2, 3, 4, 5, 6, 7]
amplitudo = [0, 5, 8, 3, -2, -4, -1, 0]

# Plot
plt.plot(waktu, amplitudo, marker='o')

# Label sumbu
plt.xlabel('Waktu (ms)')
plt.ylabel('Amplitudo')

# Judul grafik
plt.title('Trace Seismik')

# Grid opsional (biar rapi)
plt.grid(True)

# Tampilkan grafik
plt.show()
