# ===============================
# FUNGSI GREETING
# ===============================

def buat_salam(nama):
    return f"Selamat pagi, {nama}!"


# ===============================
# LIBRARY KALKULATOR (DIGABUNG)
# ===============================

def tambah(a, b):
    return a + b

def kurang(a, b):
    return a - b

def kali(a, b):
    return a * b

def bagi(a, b):
    if b == 0:
        return "Error: pembagian dengan nol"
    return a / b

def pangkat(angka, p):
    return angka ** p


# ===============================
# PROGRAM UTAMA
# ===============================

print("=== PROGRAM UTAMA ===")
print(buat_salam("Nikenya"))   # panggil fungsi sapaan
print()

while True:
    print("\n=== MENU KALKULATOR ===")
    print("1. Tambah")
    print("2. Kurang")
    print("3. Kali")
    print("4. Bagi")
    print("5. Pangkat")
    print("0. Keluar")

    pilihan = input("Pilih menu: ")

    if pilihan == "0":
        print("Program selesai. Bye!")
        break

    # Input angka
    try:
        a = float(input("Masukkan angka pertama: "))
        b = float(input("Masukkan angka kedua: "))
    except:
        print("Input harus berupa angka!")
        continue

    # Proses menu
    if pilihan == "1":
        print("Hasil =", tambah(a, b))
    elif pilihan == "2":
        print("Hasil =", kurang(a, b))
    elif pilihan == "3":
        print("Hasil =", kali(a, b))
    elif pilihan == "4":
        print("Hasil =", bagi(a, b))
    elif pilihan == "5":
        print("Hasil =", pangkat(a, b))
    else:
        print("Menu tidak tersedia.")
