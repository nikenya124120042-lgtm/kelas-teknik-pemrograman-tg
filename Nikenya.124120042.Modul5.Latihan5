import numpy as np
import matplotlib.pyplot as plt

# 1. Membuat matriks 20x50 berisi nol
data = np.zeros((20, 50))

# 2. Mengubah nilai di tengah matriks menjadi 1
data[8:12, 20:30] = 1   # blok anomali / objek

# 3. Menampilkan matriks dengan imshow
plt.imshow(data, cmap='viridis', origin='lower')
plt.colorbar(label='Nilai')
plt.title('Model Penampang 2D Sederhana')
plt.xlabel('X')
plt.ylabel('Z')

plt.show()
