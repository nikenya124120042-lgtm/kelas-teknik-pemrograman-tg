1.
# Program menghitung luas lingkaran

# Meminta input jari-jari dari pengguna
r = 9
# Menggunakan nilai Pi = 3.14
pi = 3.14
# Rumus luas lingkaran: π × r²
luas = pi * r * r
# Menampilkan hasil
print("Luas lingkaran adalah:", luas) #

# Program menyimpan dan menampilkan data pribadi

2.
